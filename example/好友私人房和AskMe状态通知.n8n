      ],
      "id": "check-private-room",
      "name": "检查是否私人房"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "ask-me-check",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ask me",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and",
          "triggerFields": {
            "leftValue": [],
            "rightValue": []
          }
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        660,
        400
      ],
      "id": "check-ask-me",
      "name": "检查是否AskMe状态"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=(企业微信机器人webhook key)",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\"msgtype\": \"text\", \"text\": {\"content\": $json.content.user.displayName + \" 进入了私人房！当前位置：\" + $json.content.location} } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        200
      ],
      "id": "notify-private-room",
      "name": "发送私人房通知"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=(企业微信机器人webhook key)",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\"msgtype\": \"text\", \"text\": {\"content\": $json.content.user.displayName + \" 的状态变为 Ask Me 了！\"} } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
